{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Tichu RL Policy",
    "type": "object",
    "required": [
        "builder",
        "state_action_values"
    ],
    "properties": {
        "builder": {
            "type": "object",
            "required": [
                "algorithm",
                "gamma",
                "min_samples",
                "episodes_seen",
                "transitions_used",
                "generated_at_utc"
            ],
            "properties": {
                "algorithm": {
                    "type": "string",
                    "const": "monte_carlo_conservative_advantage"
                },
                "gamma": {
                    "type": "number",
                    "minimum": 0.0,
                    "maximum": 1.0
                },
                "min_samples": {
                    "type": "integer",
                    "minimum": 1
                },
                "episodes_seen": {
                    "type": "integer",
                    "minimum": 0
                },
                "transitions_used": {
                    "type": "integer",
                    "minimum": 0
                },
                "transitions_seen": {
                    "type": "integer",
                    "minimum": 0
                },
                "generated_at_utc": {
                    "type": "string",
                    "format": "date-time"
                }
            },
            "additionalProperties": false
        },
        "state_action_values": {
            "type": "object",
            "additionalProperties": {
                "type": "object",
                "additionalProperties": {
                    "type": "number"
                }
            }
        },
        "coarse_state_action_values": {
            "type": "object",
            "additionalProperties": {
                "type": "object",
                "additionalProperties": {
                    "type": "number"
                }
            }
        }
    },
    "additionalProperties": false
}